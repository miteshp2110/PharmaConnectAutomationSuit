<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="PharmaConnect Automation Test Suit">
    <listeners>
        <listener class-name="com.pharmaconnect.automation.utils.ExtentReportListener" />
    </listeners>
    <parameter name="browser" value="chrome"/>
    <test name="Application Login Test" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.LoginTest"/>
        </classes>
    </test>
    <test name="Application Register Test" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.RegisterTest"/>
        </classes>
    </test>
    <test name="Register Pharmacy Test" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.RegisterPharmacyTest" />
        </classes>
    </test>
    <test name="Search Page and functionality Test" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.SearchTest"/>
        </classes>
    </test>
    <test name="Reservation Test" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.ReservationTest" />
        </classes>
    </test>
    <test name="Profile Page Tests" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.ProfileTest" />
        </classes>
    </test>
    <test name="Seller Tests" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.SellerTests" />
        </classes>
    </test>
    <test name="Seller Operations Test" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.SellerOperationsTest" />
        </classes>
    </test>
    <test name="Admin Seller Test" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.AdminTest" />
        </classes>
    </test>
    <test name="Admin Medicines Test" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.AdminMedicinesTest" />
        </classes>
    </test>
    <test name="Admin Documentation Test">
        <classes>
            <class name="com.pharmaconnect.automation.tests.AdminDocumentsTest" />
        </classes>
    </test>
</suite>