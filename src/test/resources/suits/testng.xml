<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="PharmaConnect Automation Test Suit" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="com.pharmaconnect.automation.utils.ExtentReportListener" />
    </listeners>
    <parameter name="browser" value="chrome"/>
    <test name="Application Login Test" >
        <classes>
            <class name="com.pharmaconnect.automation.tests.LoginTest"/>
        </classes>
    </test>
    <test name="Application Register Test" >
        <classes>
            <class name="com.pharmaconnect.automation.tests.RegisterTest"/>
        </classes>
    </test>
    <test name="Register Pharmacy Test" >
        <classes>
            <class name="com.pharmaconnect.automation.tests.RegisterPharmacyTest" />
        </classes>
    </test>
    <test name="Search Page and functionality Test" >
        <classes>
            <class name="com.pharmaconnect.automation.tests.SearchTest"/>
        </classes>
    </test>
    <test name="Reservation Test" >
        <classes>
            <class name="com.pharmaconnect.automation.tests.ReservationTest" />
        </classes>
    </test>
    <test name="Profile Page Tests" >
        <classes>
            <class name="com.pharmaconnect.automation.tests.ProfileTest" />
        </classes>
    </test>
    <test name="Seller Tests" >
        <classes>
            <class name="com.pharmaconnect.automation.tests.SellerTests" />
        </classes>
    </test>
    <test name="Seller Operations Test" >
        <classes>
            <class name="com.pharmaconnect.automation.tests.SellerOperationsTest" />
        </classes>
    </test>
    <test name="Admin Seller Test" >
        <classes>
            <class name="com.pharmaconnect.automation.tests.AdminTest" />
        </classes>
    </test>
    <test name="Admin Medicines Test" >
        <classes>
            <class name="com.pharmaconnect.automation.tests.AdminMedicinesTest" />
        </classes>
    </test>
    <test name="Admin Documentation Test">
        <classes>
            <class name="com.pharmaconnect.automation.tests.AdminDocumentsTest" />
        </classes>
    </test>
</suite>