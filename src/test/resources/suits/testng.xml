<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="PharmaConnect Automation Test Suit">
    <listeners>
        <listener class-name="com.pharmaconnect.automation.utils.ExtentReportListener" />
    </listeners>
    <parameter name="browser" value="chrome"/>
    <test name="Application Login Test" enabled="false">
        <classes>
            <class name="com.pharmaconnect.automation.tests.LoginTest"/>
        </classes>
    </test>
    <test name="Application Register Test">
        <classes>
            <class name="com.pharmaconnect.automation.tests.RegisterTest"/>
        </classes>
    </test>
</suite>